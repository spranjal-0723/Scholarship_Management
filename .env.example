# ==============================================================================
# SCHOLARSHIP AND FEE MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and configure local or cloud parameters.
# DO NOT commit real secrets or credentials to source control.

# Application Runtime Configuration
PORT=5050
HOST=0.0.0.0
APP_ENV=development                   # "development" (local) or "production" (Render)
APP_DATABASE_MODE=auto                # "auto" (dual engine), "oracle", or "neo4j" (cloud demo)
DEMO_READ_ONLY=false                  # Set to true on public deployments to prevent tampering
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# ------------------------------------------------------------------------------
# Oracle Database Connection Settings (Autonomous Database Free / Local Docker)
# (Used in local full-stack evaluation; optional in cloud deployment)
# ------------------------------------------------------------------------------
ORACLE_USER=admin
ORACLE_PASSWORD=replace_with_local_oracle_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_CONFIG_DIR=

# ------------------------------------------------------------------------------
# Neo4j Graph Database Connection Settings
# - For Local Docker: bolt://localhost:7687
# - For Neo4j AuraDB Cloud: neo4j+s://<instance-id>.databases.neo4j.io
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=300

# ------------------------------------------------------------------------------
# Demo Administrator Credentials (Academic Demonstration & Evaluation)
# ------------------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@scholarship.demo
DEMO_ADMIN_PASSWORD=Demo@12345
DEMO_ADMIN_NAME=Demo Administrator

# ------------------------------------------------------------------------------
# Security, Session & CORS Configuration
# ------------------------------------------------------------------------------
SESSION_COOKIE_SECURE=false           # Set to "true" on Render/HTTPS
CORS_ALLOWED_ORIGINS=*
