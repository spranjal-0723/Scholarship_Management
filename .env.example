# ============================================================
# SCHOLARSHIP AND FEE MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env and configure local parameters.
# DO NOT commit real secrets or credentials to source control.

# Flask Application Configuration
PORT=5050
HOST=0.0.0.0
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Oracle Database Connection Settings (Autonomous Database Free)
ORACLE_USER=admin
ORACLE_PASSWORD=replace_with_local_oracle_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_CONFIG_DIR=

# Neo4j Graph Database Connection Settings (Community Edition)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_local_neo4j_password
NEO4J_DATABASE=neo4j

# Demo Administrator Credentials (Academic Demonstration Only)
DEMO_ADMIN_EMAIL=admin@scholarship.demo
DEMO_ADMIN_NAME=Demo Administrator
# Optional: Pre-computed Werkzeug PBKDF2 hash; if omitted, defaults to Demo@12345
# DEMO_ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

# Security and CORS Configuration
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050
